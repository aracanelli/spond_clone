# ===========================================
# SPOND PLATFORM - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values
# For Vercel: Add these in Project Settings > Environment Variables

# -------------------------------------------
# CLERK AUTHENTICATION
# Get these from: https://dashboard.clerk.com
# -------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Clerk redirect URLs (customize as needed)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# -------------------------------------------
# SUPABASE DATABASE
# Get these from: https://supabase.com/dashboard
# -------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...

# -------------------------------------------
# WEB PUSH NOTIFICATIONS
# Generate with: npx web-push generate-vapid-keys
# -------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BPxxx...
VAPID_PRIVATE_KEY=xxx...

# -------------------------------------------
# EMAIL SERVICE (RESEND)
# Get from: https://resend.com/api-keys
# -------------------------------------------
RESEND_API_KEY=re_xxx

# -------------------------------------------
# APPLICATION SETTINGS
# -------------------------------------------
# Set to your production URL on Vercel
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -------------------------------------------
# OPTIONAL: ANALYTICS & MONITORING
# -------------------------------------------
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=
# SENTRY_DSN=

# -------------------------------------------
# VERCEL DEPLOYMENT NOTES
# -------------------------------------------
# 1. Add all NEXT_PUBLIC_* variables for both Preview and Production
# 2. Add server-only variables (CLERK_SECRET_KEY, etc.) for both environments
# 3. The VAPID keys must be the same across all environments for push notifications
# 4. Set NEXT_PUBLIC_APP_URL to your actual Vercel domain in Production
